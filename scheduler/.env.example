# PostgreSQL connection (same database as the backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AWS — no account IDs, ARNs, or credentials are hardcoded anywhere in this
# project. boto3 resolves credentials from the environment / instance role /
# ~/.aws/credentials as usual. Leave the two lines below unset (or delete
# them) if you'd rather rely on `aws configure` / ~/.aws/credentials instead —
# either source works, boto3 checks env vars first.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Name of the EventBridge event bus to publish compliance lifecycle events to.
# Use "default" to publish to the account's default bus, or the name of a
# custom bus created for this project (see docs/aws-setup.md).
EVENT_BUS_NAME=compliance-tracker-bus

# Source attribute stamped on every EventBridge event published by this
# script; the EventBridge rule that forwards to SQS matches on this value.
EVENT_SOURCE=compliance.tracker

# How many days ahead counts as "expiring soon". Must match the backend's
# dashboard "upcoming" default if you want the two to stay visually aligned.
EXPIRING_SOON_THRESHOLD_DAYS=30

LOG_LEVEL=INFO
